{
  "name": "mail_email_flat",
  "description": "A mail message without NLP fields, so it can be indexed where no enrichment runs (fleet-retrieval standalone). subject/body_preview are plain analyzed text; no entities.",
  "super": null,
  "fields": [
    {
      "name": "id",
      "type": "core_id"
    },
    {
      "name": "times",
      "type": "core_dates"
    },
    {
      "name": "subject",
      "type": "core_string",
      "groups": [
        {
          "name": "index",
          "method": "text"
        }
      ]
    },
    {
      "name": "body_preview",
      "type": "core_string",
      "groups": [
        {
          "name": "index",
          "method": "text"
        }
      ]
    },
    {
      "name": "sender_address",
      "type": "core_string",
      "groups": [
        {
          "name": "index",
          "method": "identifier"
        }
      ]
    },
    {
      "name": "sender_name",
      "type": "core_string",
      "groups": [
        {
          "name": "index",
          "method": "text"
        }
      ]
    },
    {
      "name": "sender_domain",
      "type": "core_string",
      "groups": [
        {
          "name": "index",
          "method": "identifier"
        }
      ]
    },
    {
      "name": "recipient_count",
      "type": "core_long",
      "groups": [
        {
          "name": "index",
          "method": "long"
        }
      ]
    },
    {
      "name": "mailbox_url",
      "type": "core_string",
      "groups": [
        {
          "name": "index",
          "method": "identifier"
        }
      ]
    },
    {
      "name": "read",
      "type": "core_boolean",
      "groups": [
        {
          "name": "index",
          "method": "identifier"
        }
      ]
    },
    {
      "name": "flagged",
      "type": "core_boolean",
      "groups": [
        {
          "name": "index",
          "method": "identifier"
        }
      ]
